# Nico API — passar o cabeçalho Authorization ao PHP (alguns servidores CGI perdem-no)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
Options -Indexes
<FilesMatch "^(config_local|config_local\.exemplo)\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|db|log)$">
  Require all denied
</FilesMatch>
